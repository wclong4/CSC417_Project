// Should print 1 2 3 4 5 (possibly on separate lines, depending on
// 'print' implementation).
//
// Return value is 'null' because 'print' returns no useful value.

{
    def count = fn(n) {
            n = add(n, 1);
            n
    };

    def n = 0;
    print(count(n));
    print(count(n));
    print(count(n));
    print(count(n));
    print(count(n))
}